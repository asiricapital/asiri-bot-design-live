/* ============================================================
   Asiri Capital v5.7 — Enhanced Design System
   تحسينات شاملة: شريط جانبي، Header، بطاقات، جداول، موبايل
   ============================================================ */

:root {
  --bg:       #06111d;
  --panel:    #0c2032;
  --panel2:   #10283d;
  --panel3:   #0a1e30;
  --line:     #1e3a52;
  --line2:    #28455d;
  --text:     #f0f5fa;
  --muted:    #7a95aa;
  --green:    #1ecf84;
  --red:      #ff4d5e;
  --gold:     #e8b84b;
  --blue:     #3d7fff;
  --blue2:    #2563cc;
  --teal:     #0ea5a0;
  --shadow:   0 8px 32px #00000055;
  --shadow2:  0 2px 12px #00000033;
  --radius:   18px;
  --radius-sm:12px;
  --radius-xs:8px;
  --nav-w:    220px;
  --topbar-h: 72px;
  --transition: 0.18s ease;
}

/* ── Reset & Base ── */
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Tahoma, "Noto Sans Arabic", sans-serif;
  font-size: 14px;
  line-height: 1.6;
  overflow-x: hidden;
}
button, input, textarea, select { font: inherit; }

/* ── Buttons ── */
button {
  border: 0;
  border-radius: var(--radius-sm);
  background: var(--blue);
  color: #fff;
  padding: 9px 16px;
  font-weight: 700;
  cursor: pointer;
  transition: background var(--transition), transform var(--transition), box-shadow var(--transition);
  white-space: nowrap;
}
button:hover  { background: var(--blue2); box-shadow: 0 4px 16px #3d7fff44; }
button:active { transform: scale(0.97); }
.secondary, .ghost {
  background: transparent;
  border: 1px solid var(--line2);
  color: var(--muted);
}
.secondary:hover, .ghost:hover { background: var(--panel2); color: var(--text); border-color: var(--blue); }
.ghost.active { background: var(--panel2); color: #fff; border-color: var(--blue); }
.danger { background: #3d1420; color: #ff8090; border: 1px solid #7a2535; }
.danger:hover { background: #5a1a2e; }

/* ── Utilities ── */
.hidden   { display: none !important; }
.eyebrow  { letter-spacing: .18em; color: var(--gold); font-size: .68rem; font-weight: 800; text-transform: uppercase; }
.muted, .status { color: var(--muted); }
.up    { color: var(--green) !important; }
.down  { color: var(--red)   !important; }
.flat  { color: var(--muted) !important; }

/* ── Top Bar ── */
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 clamp(16px, 3vw, 40px);
  height: var(--topbar-h);
  border-bottom: 1px solid var(--line);
  background: rgba(6, 17, 29, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  position: sticky;
  top: 0;
  z-index: 30;
}
.topbar > div:first-child { display: flex; align-items: center; gap: 14px; }
.topbar .eyebrow { font-size: .6rem; }
.topbar h1 {
  margin: 0;
  font-size: clamp(1.1rem, 2.5vw, 1.6rem);
  font-weight: 900;
  letter-spacing: -.01em;
}
.topbar p { margin: 0; color: var(--muted); font-size: .8rem; }
.topbar-brand { display: flex; flex-direction: column; }
.header-actions { display: flex; align-items: center; gap: 10px; }
.pill {
  border: 1px solid var(--line2);
  border-radius: 999px;
  padding: 6px 14px;
  color: var(--muted);
  font-size: .8rem;
  white-space: nowrap;
}
.pill.connected { border-color: var(--green); color: var(--green); background: #1ecf8415; }

/* ── App Shell ── */
.app-shell {
  display: grid;
  grid-template-columns: var(--nav-w) minmax(0, 1fr);
  max-width: 1600px;
  margin: 0 auto;
  min-height: calc(100vh - var(--topbar-h));
}

/* ── Sidebar Navigation ── */
.main-nav {
  padding: 16px 10px;
  border-left: 1px solid var(--line);
  position: sticky;
  top: var(--topbar-h);
  height: calc(100vh - var(--topbar-h));
  overflow-y: auto;
  overflow-x: hidden;
  align-self: start;
  background: rgba(6, 17, 29, 0.6);
  scrollbar-width: thin;
  scrollbar-color: var(--line2) transparent;
}
.main-nav::-webkit-scrollbar { width: 4px; }
.main-nav::-webkit-scrollbar-thumb { background: var(--line2); border-radius: 4px; }

.nav-section-label {
  font-size: .6rem;
  font-weight: 800;
  letter-spacing: .15em;
  color: var(--muted);
  text-transform: uppercase;
  padding: 14px 10px 6px;
  opacity: 0.6;
}
.main-nav button {
  width: 100%;
  display: flex;
  gap: 9px;
  align-items: center;
  text-align: right;
  background: transparent;
  color: var(--muted);
  margin: 2px 0;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  font-size: .85rem;
  font-weight: 600;
  direction: rtl;
  transition: background var(--transition), color var(--transition), transform var(--transition);
  box-shadow: none;
}
.main-nav button:hover {
  background: var(--panel2);
  color: var(--text);
  transform: none;
  box-shadow: none;
}
.main-nav button.active {
  background: linear-gradient(135deg, #1a3a5c, #0f2a42);
  color: #fff;
  border: 1px solid var(--blue);
  box-shadow: 0 2px 12px #3d7fff22;
}
.main-nav span { font-size: 1rem; width: 20px; text-align: center; flex-shrink: 0; }
.nav-badge {
  display: inline-grid;
  place-items: center;
  min-width: 18px;
  height: 18px;
  padding: 0 4px;
  border-radius: 999px;
  background: #ef4444;
  color: #fff;
  font-size: 10px;
  margin-right: auto;
}

/* ── Main Content ── */
main { padding: 22px 24px; min-width: 0; }
.page { display: none; }
.page.active { display: block; }

/* ── Page Title & Section Head ── */
.page-title, .section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}
.page-title h2, .section-head h3 { margin: 4px 0; font-size: 1.15rem; }

/* ── Panels & Cards ── */
.panel, .market-panel, .metric, .card, .auth-card {
  background: linear-gradient(145deg, var(--panel), var(--panel3));
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow2);
}
.panel { padding: 20px; margin-bottom: 16px; }
.panel:hover { border-color: var(--line2); }

/* ── Market Panel ── */
.market-panel {
  padding: 20px 24px;
  display: grid;
  grid-template-columns: 1fr auto 2fr;
  gap: 20px;
  align-items: center;
  margin-bottom: 16px;
}
.market-panel strong { font-size: 1.8rem; font-weight: 900; }
.score-ring {
  width: 90px;
  height: 90px;
  border: 12px solid #17435e;
  border-radius: 50%;
  display: grid;
  place-content: center;
  text-align: center;
}
.score-ring b { font-size: 1.7rem; font-weight: 900; }
.indices { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.index { background: #071827; border-radius: var(--radius-xs); padding: 10px; }
.index b, .index small { display: block; }

/* ── Summary & Score Grid ── */
.summary, .mi-score-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin: 14px 0;
}
.metric { padding: 16px 18px; }
.metric span, .details span, .analysis-grid span { color: var(--muted); display: block; font-size: .8rem; margin-bottom: 4px; }
.metric strong { font-size: 1.25rem; font-weight: 800; }

/* ── Mission Grid ── */
.mission-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin: 14px 0;
}
.mission-card { min-height: 110px; padding: 16px; }
.mission-value, .big-decision { font-size: 1rem; font-weight: 800; line-height: 1.6; margin-top: 10px; }

/* ── Alerts & Lists ── */
.alerts, .compact-list, .position-list, .trade-list, .alert-center-list { display: grid; gap: 8px; }
.alert, .compact-row, .position-row, .result-row, .watch-card, .trade-row {
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: #071827;
}
.compact-row, .position-row, .result-row, .watch-card, .trade-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
}
.compact-row small, .position-row small, .result-row small, .trade-row small { display: block; color: var(--muted); font-size: .78rem; }

/* ── Portfolio Grid ── */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
  gap: 14px;
  margin-bottom: 18px;
}
.card { padding: 18px; transition: border-color var(--transition), box-shadow var(--transition); }
.card:hover { border-color: var(--line2); box-shadow: var(--shadow); }
.top, .analysis-hero, .opportunity-head { display: flex; justify-content: space-between; gap: 10px; }
.symbol { font-size: 1.35rem; font-weight: 900; }
.name { color: var(--muted); font-size: .82rem; }
.price { font-size: 2rem; font-weight: 900; margin-top: 14px; }
.change { font-weight: 800; font-size: .95rem; }
.spark { height: 60px; width: 100%; color: var(--blue); margin: 8px 0; }
.decision { background: #071827; border-radius: var(--radius-sm); padding: 12px; }
.decision b, .decision span { display: block; }
.decision span { color: var(--muted); font-size: .82rem; }
.scorebar { height: 4px; background: #173247; margin-top: 8px; border-radius: 10px; overflow: hidden; }
.scorebar i { display: block; height: 100%; background: var(--green); }
.details, .analysis-grid, .opportunity-grid, .form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}
.details { margin-top: 12px; }
.details > div, .analysis-grid > div { border-top: 1px solid #18364c; padding-top: 8px; }
.foot { display: flex; justify-content: space-between; color: var(--muted); font-size: .75rem; margin-top: 12px; }

/* ── Forms ── */
.manager-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
label { display: grid; gap: 6px; color: var(--muted); margin-bottom: 10px; font-size: .85rem; }
input, textarea, select {
  width: 100%;
  background: #061522;
  color: #fff;
  border: 1px solid var(--line2);
  border-radius: var(--radius-sm);
  padding: 10px 12px;
  transition: border-color var(--transition);
}
input:focus, textarea:focus, select:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px #3d7fff22; }
.form-actions, .row-actions, .auth-actions, .page-actions, .alert-toolbar, .opportunity-actions, .position-actions {
  display: flex; gap: 8px; flex-wrap: wrap;
}

/* ── Tables ── */
.table-wrap { overflow: auto; border-radius: var(--radius-sm); }
.technical-table { width: 100%; border-collapse: collapse; white-space: nowrap; }
.technical-table th {
  padding: 10px 12px;
  border-bottom: 2px solid var(--line2);
  text-align: right;
  color: var(--muted);
  font-size: .78rem;
  font-weight: 700;
  letter-spacing: .05em;
  background: var(--panel3);
}
.technical-table td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: right; font-size: .88rem; }
.technical-table tr:hover td { background: #0a1e3022; }

/* ── Search & Watch ── */
.inline-form, .search-form { display: grid; grid-template-columns: 1fr 2fr auto; gap: 10px; }
.watch-grid, .golden-grid, .admin-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; }
.search-results { display: grid; gap: 8px; margin-top: 12px; }
.analysis-card, .golden-card { background: #081a29; border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; }
.golden-card { border-color: #6b5220; background: linear-gradient(145deg, #1a2218, #0a1920); }
.confidence { background: #112526; border: 1px solid #2e5a3c; border-radius: var(--radius-sm); padding: 8px 12px; text-align: center; }
.opportunity-grid > div { background: #071827; border: 1px solid var(--line); border-radius: var(--radius-xs); padding: 10px; }

/* ── Sharia ── */
.sharia-note { padding: 10px 12px; border-radius: var(--radius-sm); background: #2e2210; color: #ffd980; border: 1px solid #5e4a1e; }

/* ── Reports ── */
.report-tabs { display: flex; gap: 8px; margin-bottom: 12px; overflow: auto; }
.report-tabs button { background: transparent; border: 1px solid var(--line2); white-space: nowrap; color: var(--muted); }
.report-tabs button.active { background: var(--blue); color: #fff; border-color: var(--blue); }
.report-paper { line-height: 1.9; }
.report-paper h3 { color: var(--gold); }

/* ── Trade Dialog ── */
.trade-dialog { border: 0; padding: 0; background: transparent; color: var(--text); width: min(620px, 94vw); }
.trade-dialog::backdrop { background: rgba(2, 8, 16, 0.88); }
.trade-card { background: linear-gradient(145deg, var(--panel), #071522); border: 1px solid var(--line2); border-radius: var(--radius); padding: 22px; }

/* ── MI Hero ── */
.mi-hero {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  align-items: center;
  border-color: #2a5070;
  background: radial-gradient(circle at 85% 10%, #122e48 0, transparent 40%),
              linear-gradient(145deg, #0d2336, #071522);
}
.mi-hero h3 { font-size: clamp(1.25rem, 2.5vw, 1.9rem); margin: 6px 0; }
.mi-status-stack { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.mi-status { min-width: 130px; padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: #061522; }
.mi-status span, .mi-status strong { display: block; }
.mi-status span { font-size: .75rem; color: var(--muted); margin-bottom: 4px; }
.mi-status strong { font-size: 1.1rem; font-weight: 800; }

/* ── MI Score Grid ── */
.mi-score-grid { grid-template-columns: repeat(5, 1fr); }

/* ── MI Golden Panel ── */
.mi-golden-panel {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: center;
  border-color: #6b5220;
  background: radial-gradient(circle at 92% 30%, #3d2c10 0, transparent 35%),
              linear-gradient(145deg, #12201a, #081520);
}
.mi-golden-score {
  min-width: 160px;
  text-align: center;
  padding: 16px;
  border-radius: var(--radius);
  background: #071827;
  border: 1px solid #6b5220;
  flex-shrink: 0;
}
.mi-golden-score span, .mi-golden-score small { display: block; color: var(--muted); font-size: .78rem; }
.mi-golden-score strong { display: block; color: var(--gold); font-size: 2.6rem; font-weight: 900; }

/* ── MI Top Grid ── */
.mi-top-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.mi-opportunity-card {
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: linear-gradient(145deg, #0e2438, #071827);
  transition: border-color var(--transition);
}
.mi-opportunity-card:hover { border-color: var(--blue); }
.mi-rank { color: var(--gold); font-weight: 800; margin-bottom: 10px; font-size: .82rem; }
.mi-opportunity-head { display: flex; justify-content: space-between; align-items: center; }
.mi-opportunity-head strong { font-size: 1.4rem; font-weight: 900; }
.mi-opportunity-head small { display: block; color: var(--muted); font-size: .78rem; }
.mi-score { font-size: 1.8rem; font-weight: 900; color: var(--green); }
.mi-opportunity-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 12px; }
.mi-opportunity-meta span { padding: 7px 8px; border-radius: var(--radius-xs); background: #061522; color: var(--muted); font-size: .78rem; }
.mi-opportunity-meta b { display: block; color: var(--text); font-size: .88rem; }

/* ── MI Filters ── */
.mi-filters { display: flex; gap: 6px; flex-wrap: wrap; }
.mi-decision { display: inline-block; border-radius: 999px; padding: 4px 10px; font-size: .75rem; font-weight: 800; }
.mi-decision.buy   { background: #1ecf8422; color: var(--green); }
.mi-decision.wait  { background: #e8b84b22; color: var(--gold); }
.mi-decision.avoid { background: #ff4d5e22; color: var(--red); }

/* ── Sharia Watch ── */
.sharia-watch-panel { border-color: #5e4a1e; }
.sharia-watch-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px; }
.sharia-watch-item { display: flex; justify-content: space-between; gap: 8px; padding: 10px 12px; border: 1px solid #5e4a1e; border-radius: var(--radius-sm); background: #2e221855; }
.sharia-watch-item span { color: #ffd980; font-size: .82rem; }

/* ── Dashboard Disclaimer ── */
.dashboard-disclaimer { text-align: center; color: var(--muted); font-size: .78rem; padding: 16px; opacity: 0.7; }

/* ── Risk & Journal ── */
.risk-control-panel { border-color: #6a4520; }
.urgent-actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px; }
.urgent-item { display: flex; justify-content: space-between; gap: 8px; padding: 12px; border-radius: var(--radius-sm); border: 1px solid var(--line); background: #071827; }
.urgent-item.critical { border-color: #8a2030; background: #3d121c55; }
.urgent-item.high     { border-color: #7a5a20; background: #3d2c1055; }
.urgent-item.good     { border-color: #1e6040; background: #0e3020 55; }
.plan-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
.plan-card { padding: 14px; border: 1px solid var(--line); border-radius: var(--radius); background: #071827; }
.plan-card.high, .plan-card.critical { border-color: #7a2535; }
.plan-meta, .journal-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 10px 0; }
.plan-meta span, .journal-meta span { padding: 7px 8px; background: var(--panel); border-radius: var(--radius-xs); color: var(--muted); font-size: .8rem; }
.plan-meta b, .journal-meta b { display: block; color: var(--text); }
.risk-rules { display: grid; gap: 8px; }
.risk-rules p { margin: 0; padding: 10px; border: 1px solid #6a3a22; background: #321a1055; border-radius: var(--radius-sm); }
.journal-list { display: grid; gap: 10px; }
.journal-card { padding: 15px; border: 1px solid var(--line); border-radius: var(--radius); background: #071827; }
.journal-card.blocked { border-color: #8a2030; background: #3d121c33; }
.journal-card small { color: var(--muted); font-size: .78rem; }
.journal-outcome { padding: 5px 10px; border-radius: 999px; background: var(--panel2); color: var(--gold); font-weight: 800; font-size: .82rem; }
.lesson { padding: 10px; border-right: 3px solid var(--gold); background: #2e221855; color: #ffd980; border-radius: 0 var(--radius-xs) var(--radius-xs) 0; }
.position-actions { grid-template-columns: repeat(4, 1fr); }

/* ── Reconciliation ── */
.reconciliation-panel { border-color: #2e5a7a; }
.recovery-panel { border-color: #6a5520; }
.recovery-track { height: 12px; background: #071827; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; }
.recovery-track i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--blue), var(--green)); transition: width .4s ease; }
.reconciliation-panel .summary, .recovery-panel .summary { grid-template-columns: repeat(4, 1fr); }

/* ── Verified Feed Bar ── */
#verifiedFeedBar {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px clamp(16px, 3vw, 40px);
  background: #071827;
  border-bottom: 1px solid var(--line);
  font-size: .78rem;
  color: var(--muted);
  flex-wrap: wrap;
}
#verifiedFeedBar strong { color: var(--gold); }
#verifiedFeedBar .feed-stats { display: flex; gap: 16px; }
#verifiedFeedBar .feed-stat span { color: var(--muted); }
#verifiedFeedBar .feed-stat b { color: var(--text); }

/* ============================================================
   Responsive — 1000px
   ============================================================ */
@media (max-width: 1000px) {
  .mi-score-grid { grid-template-columns: repeat(3, 1fr); }
  .mi-top-grid   { grid-template-columns: 1fr; }
  .mission-grid  { grid-template-columns: repeat(2, 1fr); }
  :root { --nav-w: 190px; }
}

/* ============================================================
   Responsive — 900px (Tablet)
   ============================================================ */
@media (max-width: 900px) {
  :root { --topbar-h: 60px; }

  .topbar { position: sticky; }
  .topbar h1 { font-size: 1.15rem; }
  .topbar p { display: none; }

  .app-shell { display: block; }

  /* Horizontal scrollable nav */
  .main-nav {
    position: sticky;
    top: var(--topbar-h);
    z-index: 20;
    height: auto;
    min-height: auto;
    border: 0;
    border-bottom: 1px solid var(--line);
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    background: rgba(6, 17, 29, 0.96);
    padding: 6px 10px;
    gap: 4px;
    scrollbar-width: none;
  }
  .main-nav::-webkit-scrollbar { display: none; }
  .main-nav button { min-width: max-content; width: auto; padding: 8px 12px; font-size: .8rem; }
  .nav-section-label { display: none; }

  .market-panel { grid-template-columns: 1fr auto; }
  .indices { grid-column: 1 / -1; }
  .summary, .mi-score-grid { grid-template-columns: 1fr 1fr; }
  .manager-layout { grid-template-columns: 1fr; }
  main { padding: 14px 16px; }
  .inline-form, .search-form { grid-template-columns: 1fr; }
  .mi-hero, .mi-golden-panel { flex-direction: column; align-items: flex-start; }
  .mi-golden-score { width: 100%; }
  .reconciliation-panel .summary, .recovery-panel .summary { grid-template-columns: repeat(2, 1fr); }
}

/* ============================================================
   Responsive — 620px (Mobile)
   ============================================================ */
@media (max-width: 620px) {
  :root { --topbar-h: 56px; }

  .topbar { padding: 0 14px; }
  .topbar h1 { font-size: 1rem; }

  .summary, .mi-score-grid, .mission-grid { grid-template-columns: 1fr 1fr; }
  .form-grid, .details, .analysis-grid, .opportunity-grid { grid-template-columns: 1fr; }
  .market-panel { padding: 14px; }
  .score-ring { width: 76px; height: 76px; border-width: 10px; }
  .score-ring b { font-size: 1.4rem; }
  .indices { grid-template-columns: 1fr 1fr; }
  .page-title, .section-head { align-items: flex-start; flex-direction: column; }
  .mi-status-stack { width: 100%; grid-template-columns: 1fr 1fr; }
  .mi-opportunity-meta { grid-template-columns: 1fr; }
  .alert-item { grid-template-columns: auto 1fr; }
  .position-actions { grid-template-columns: 1fr 1fr; }
  .plan-meta, .journal-meta { grid-template-columns: 1fr; }
  .panel { padding: 14px; }
  .metric { padding: 12px 14px; }
  .metric strong { font-size: 1.1rem; }
  .mi-top-grid { grid-template-columns: 1fr; }
  .mi-score-grid { grid-template-columns: repeat(2, 1fr); }
}

/* ============================================================
   Responsive — 400px (Small Mobile)
   ============================================================ */
@media (max-width: 400px) {
  .summary, .mi-score-grid, .mission-grid { grid-template-columns: 1fr; }
  .topbar h1 { font-size: .9rem; }
  .mi-status-stack { grid-template-columns: 1fr; }
}
